{
  "manifest_version": 3,
  "name": "Точный Масштаб PRO",
  "version": "1.4",
  "description": "Ползунок масштаба с шагом 1%, кнопкой сброса и запоминанием сайтов.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  }
}